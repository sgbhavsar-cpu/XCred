<Project>
  <!--
    Opt-in only (dotnet publish ... -p:PublishProfile=Portable) — the default
    `dotnet publish` used by scripts/publish.ps1 (the existing IIS installer's build step)
    is completely unaffected by this profile's existence.

    Produces a single self-contained win-x64 executable that needs no separately-installed
    .NET runtime and no IIS Hosting Bundle — see scripts/publish-portable.ps1.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
