app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Interop spike outputs — regenerated each run (`node spike/gen_vectors.mjs`, then
# `flutter test test/crypto_interop_spike_test.dart`), and contain real (if throwaway,
# meaningless outside this repro) RSA private key material that shouldn't sit in a
# public repo regardless. The spike scripts themselves stay tracked.
spike/*.json
